# Copy to .env.local and fill in from https://dashboard.emailjs.com
# These are public keys — safe in client code — but restrict the template
# to your own domain in the EmailJS dashboard.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_ORDER_TEMPLATE_ID=
VITE_EMAILJS_CONTACT_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Only needed for a project page at https://<user>.github.io/<repo>/
# Leave unset for a custom domain such as bestimpo.com
# VITE_BASE=/bestimpo/
